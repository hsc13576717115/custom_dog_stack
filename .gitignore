# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# Isaac Sim / Isaac Lab generated files
logs/
outputs/
reports/data/
*.usd
*.usda
*.usdc
.cache/
.omniverse/

# Training artifacts. Promote only reviewed ONNX files under deploy/releases.
*.pt
*.pth
*.ckpt
events.out.tfevents.*
artifacts/traces/

# One explicitly promoted checkpoint may be kept for reproducible fine-tuning.
artifacts/checkpoints/*
!artifacts/checkpoints/README.md
!artifacts/checkpoints/omni45-axis4698/
!artifacts/checkpoints/omni45-axis4698/**

# Candidate exports are local evaluation scratch space. Promote a selected
# policy to deploy/releases/<version>/ before committing it.
deploy/candidates/*
!deploy/candidates/.gitkeep

# ROS 2 / colcon
build/
install/
log/
ros2/build_recovery_check/
ros2/install_recovery_check/
third_party/custom_dog_control_deps_ws/

